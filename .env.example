# ==========================================
# ReachInbox Email Scheduler Environment Config
# ==========================================

# Backend Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://reachinbox:reachinbox123@localhost:5432/reachinbox_db?schema=public

# Redis (BullMQ & Rate Limiter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Worker Settings
WORKER_CONCURRENCY=5

# Authentication (JWT & Google OAuth)
JWT_SECRET=super_secret_jwt_key_reachinbox_change_me_in_production
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Slack OAuth Integration (Primary)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/v1/slack/callback

# Slack Direct Webhook (Optional Local Testing Fallback)
DEFAULT_SLACK_WEBHOOK_URL=

# Bull Board Dashboard
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin

# Frontend Environment Variables (Prefix with VITE_)
VITE_API_URL=http://localhost:5000/api/v1
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
